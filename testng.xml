<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="Enhanced Test Automation Suite" parallel="tests" thread-count="3" verbose="2">
    
    <!-- Enhanced TestNG Listeners -->
    <listeners>
        <listener class-name="project_team09.utilities.EnhancedTestListener"/>
        <listener class-name="project_team09.utilities.Listeners"/>
